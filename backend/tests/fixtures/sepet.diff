+def calculate_total(items, discount=0):
+    total = sum(i["price"] * i["qty"] for i in items)
+    if discount:
+        total = total - total * discount / 100
+    return round(total, 2)
+
+def average_price(items):
+    return sum(i["price"] for i in items) / len(items)
