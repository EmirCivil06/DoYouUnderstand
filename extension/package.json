{
  "name": "anladin-mi",
  "displayName": "Anladın mı?",
  "description": "Commit'ten önce değişikliğin hakkında soru sorar, yanlışta Türkçe anlatır. Kapı değil, öğretmen.",
  "version": "0.4.0",
  "publisher": "doyouunderstand",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["SCM Providers", "Education"],
  "main": "./out/extension.js",
  "extensionDependencies": ["vscode.git"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "anladinmi.commitWithQuiz",
        "title": "Anladın mı? ile commit'le",
        "category": "Anladın mı?",
        "icon": "$(mortar-board)"
      },
      {
        "command": "anladinmi.installHook",
        "title": "Commit butonuna bağla (hook kur)",
        "category": "Anladın mı?"
      },
      {
        "command": "anladinmi.removeHook",
        "title": "Commit butonundan ayır (hook kaldır)",
        "category": "Anladın mı?"
      }
    ],
    "keybindings": [
      {
        "command": "anladinmi.commitWithQuiz",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "scmRepository"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "anladinmi.commitWithQuiz",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Anladın mı?",
      "properties": {
        "anladinmi.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Backend (FastAPI) adresi."
        },
        "anladinmi.difficulty": {
          "type": "string",
          "enum": ["kolay", "orta", "zor"],
          "default": "orta",
          "description": "Soruların zorluğu."
        },
        "anladinmi.numQuestions": {
          "type": "number",
          "minimum": 1,
          "maximum": 5,
          "default": 3,
          "description": "Kaç soru sorulsun (1-5)."
        },
        "anladinmi.autoConnectHook": {
          "type": "boolean",
          "default": true,
          "description": "Repo açılınca mavi Commit butonunu sormadan quiz'e bağla (pre-commit hook kurar). Başka bir hook varsa dokunmaz."
        },
        "anladinmi.mockMode": {
          "type": "boolean",
          "default": false,
          "description": "Backend yerine örnek sorular kullan (backend hazır değilken geliştirme/demo için)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository --skip-license",
    "sahte-backend": "node scripts/sahte-backend.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
